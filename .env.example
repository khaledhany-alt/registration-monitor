# Test accounts are kept, so make them easy to spot and filter.
# {brand} becomes daftra/enerpize and {stamp} makes every run unique.
# Use a real mailbox (plus addressing) so welcome emails don't bounce.
SIGNUP_EMAIL_TEMPLATE=regmonitor+{brand}-{stamp}@example.com

# Phone used on the form. Egypt (+20) skips the Saudi-only OTP step.
# National number; a leading 0 is dropped.
SIGNUP_DIAL_CODE=+20
SIGNUP_PHONE=

# Optional. Set it if the team should be able to log in to the test accounts.
# Left empty, each run uses a random password.
SIGNUP_PASSWORD=

SIGNUP_BUSINESS_NAME=Registration Monitor

# Optional overrides.
# DAFTRA_REGISTER_URL=https://www.daftra.com/en/register
# ENERPIZE_REGISTER_URL=https://www.enerpize.com/register
# CHROME_PATH=/usr/bin/google-chrome
# SIGNUP_TIMEOUT_SECONDS=120
